# Outline Configuration
OUTLINE_API_KEY=ol_api_your_outline_token_here
OUTLINE_BASE_URL=https://outline.your-domain.com
OUTLINE_COLLECTION_ID=your_collection_uuid_here

# Zulip Configuration
ZULIP_BOT_EMAIL=transcriber-bot@your-zulip-domain.com
ZULIP_BOT_API_KEY=your_zulip_api_key_here
ZULIP_SITE=https://zulip.your-domain.com

# Transcriber Configuration
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# Storage
AUDIO_OUTPUT_DIR=./data
