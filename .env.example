# jitsi-capture configuration. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored — never commit real hosts, emails or keys.

# --- Zulip (required) -------------------------------------------------------
# Base URL of the Zulip server, no trailing slash.
ZULIP_SITE=https://zulip.your-domain.com
# Generic bot: Settings -> Personal -> Bots -> Add a new bot (type "Generic").
# Subscribe it to every stream whose calls should be recordable.
ZULIP_BOT_EMAIL=notetaker-bot@your-domain.com
ZULIP_BOT_API_KEY=your_zulip_api_key_here

# --- Jitsi ------------------------------------------------------------------
# Base URL of the Jitsi deployment the Zulip call button links to. Only
# messages containing a link under this URL are offered a recording.
JITSI_BASE_URL=https://meet.jit.si

# --- Storage ----------------------------------------------------------------
# Container path for job state and audio; jobs live in DATA_DIR/jobs/<id>/.
DATA_DIR=/data
# Audio lives in the named volume `jitsi-capture-data`; the transcriber stack
# mounts the same volume at the same path, so HOST_DATA_DIR stays unset and the
# audio_path in the webhook needs no translation. Only set it if the receiving
# service sees the recordings under a different path than DATA_DIR.
#HOST_DATA_DIR=
# Recordings older than this many days are deleted by the hourly sweep.
# 0 or less keeps everything.
AUDIO_RETENTION_DAYS=7

# --- Recorder ---------------------------------------------------------------
# Path to the Node recorder; the Docker image already sets it.
RECORDER_PATH=/app/recorder/record.js
# Display name the bot joins the call with.
BOT_DISPLAY_NAME=NoteTaker
# Give up if the bot is not admitted within this many seconds (lobby included).
JOIN_TIMEOUT_S=600
# Hard cap on one recording (4 hours).
MAX_DURATION_S=14400
# Stop after this many seconds alone in the room.
EMPTY_GRACE_S=60
# Anything shorter than this is reported as too_short and not sent on.
MIN_RECORDING_S=15

# --- Webhook ----------------------------------------------------------------
# Where recording.finished is delivered. Leave empty to disable the webhook
# (the service then only records and logs "webhook disabled").
WEBHOOK_URL=http://transcriber:8000/webhook
# Shared secret: signs the outgoing webhook and verifies inbound POST /notify.
# Required whenever WEBHOOK_URL is set.
WEBHOOK_SECRET=change-me

# --- HTTP server ------------------------------------------------------------
# Address the service listens on inside the container.
LISTEN_ADDR=:8080
# How the downstream service reaches this one; callback_url in the webhook is
# PUBLIC_URL + "/notify".
PUBLIC_URL=http://jitsi-capture:8080

# --- Traefik ----------------------------------------------------------------
# Public hostname Traefik routes to this service (POST /notify, GET /health).
DOMAIN=jitsi-capture.your-domain.com
# Name of the existing external Docker network Traefik runs on.
TRAEFIK_NETWORK_NAME=traefik
# Traefik ACME certificate resolver that issues the TLS certificate.
TRAEFIK_CERTRESOLVER=myresolver

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
